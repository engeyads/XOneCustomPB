<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7"
    android:orientation="horizontal">

    <!-- LEFT COLUMN: INPUT TEST VISUALIZER -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:background="#ECEFF3"
        android:orientation="vertical">

        <!-- HEADER BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#E1E5EC"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="INPUT TEST"
                android:textColor="#1A1C20"
                android:textSize="14sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="PRESS A BUTTON · DRAG A STICK"
                android:textColor="#707684"
                android:textSize="11sp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D1D6E0" />

        <!-- CONTROLLER VISUALIZER -->
        <com.tabletgamepadbridge.GamepadVisualizerView
            android:id="@+id/controllerVisualizer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="12dp" />

    </LinearLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#CBD0DC" />

    <!-- RIGHT COLUMN: PAD LINK DASHBOARD -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#F7F8FA"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP BAR: PAD LINK HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="PAD LINK"
                    android:textColor="#111318"
                    android:textSize="20sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="WIRELESS CONTROLLER 01"
                    android:textColor="#727885"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <TextView
                android:id="@+id/connectedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="#FDE8E8"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="DISCONNECTED"
                android:textColor="#C83232"
                android:textSize="11sp"
                android:letterSpacing="0.05" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#D1D6E0" />

        <!-- METRICS ROW: BATTERY | LATENCY | POLL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="BATTERY"
                    android:textColor="#727885"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="78%"
                    android:textColor="#111318"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#D1D6E0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="LATENCY"
                    android:textColor="#727885"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/latencyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="8 ms"
                    android:textColor="#111318"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#D1D6E0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="POLL"
                    android:textColor="#727885"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/pollText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="250 Hz"
                    android:textColor="#111318"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#D1D6E0" />

        <!-- LIVE INPUT SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="LIVE INPUT"
            android:textColor="#111318"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="LEFT STICK"
                android:textColor="#727885"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/leftStickCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-black"
                android:text="+0.00 , +0.00"
                android:textColor="#111318"
                android:textSize="12sp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="RIGHT STICK"
                android:textColor="#727885"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/rightStickCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-black"
                android:text="+0.00 , +0.00"
                android:textColor="#111318"
                android:textSize="12sp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="LEFT TRIGGER (LT)"
                android:textColor="#727885"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/leftTriggerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-black"
                android:text="0%"
                android:textColor="#111318"
                android:textSize="12sp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="RIGHT TRIGGER (RT)"
                android:textColor="#727885"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/rightTriggerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-black"
                android:text="0%"
                android:textColor="#111318"
                android:textSize="12sp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="LAST INPUT"
                android:textColor="#727885"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/lastInputText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-black"
                android:text="—"
                android:textColor="#C83232"
                android:textSize="12sp" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#D1D6E0" />

        <!-- DEADZONE SECTION -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="DEADZONE"
                android:textColor="#111318"
                android:textSize="12sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/deadzoneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-bold"
                android:text="27%"
                android:textColor="#111318"
                android:textSize="12sp" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/deadzoneProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="27"
            android:progressDrawable="@android:drawable/progress_horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#D1D6E0" />

        <!-- PRIVILEGED HELPER & BUTTONS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="PRIVILEGED HELPER"
            android:textColor="#727885"
            android:textSize="10sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/helperStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="NOT CONNECTED"
            android:textColor="#C83232"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wirelessStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text=""
            android:textColor="#525866"
            android:textSize="11sp" />

        <!-- ACTION BUTTONS GRID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/recenterBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.2"
                android:backgroundTint="#EF3313"
                android:fontFamily="sans-serif-bold"
                android:text="Recenter sticks"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E5E8EF"
                android:fontFamily="sans-serif-bold"
                android:text="Connect"
                android:textColor="#111318"
                android:textSize="11sp" />

            <Button
                android:id="@+id/openAccessibilityBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E5E8EF"
                android:fontFamily="sans-serif-bold"
                android:text="Settings"
                android:textColor="#111318"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
